    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numqualquer" type="Real" array="False" size=""/>
            <output expression="&quot;insira o valor de compra&quot;" newline="True"/>
            <input variable="numqualquer"/>
            <if expression="numqualquer&gt;=100">
                <then>
                    <output expression="&quot; ele ganhou um desconto de 10%&quot; &amp; numqualquer *0.9" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;nao tem desconto&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
