    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numNumero" type="Real" array="False" size=""/>
            <output expression="&quot;digite algum numero&quot;" newline="True"/>
            <input variable="numNumero"/>
            <if expression="numNumero % 5 == 0">
                <then>
                    <output expression="&quot;o numero &quot; &amp; numNumero &amp; &quot;&#233; mutiplo de 5&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot; o numero&quot; &amp; numNumero&amp; &quot; &#233; menor que multiplo de 5&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
