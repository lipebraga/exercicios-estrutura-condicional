    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numidade" type="Integer" array="False" size=""/>
            <output expression="&quot;insira sua idade &quot;" newline="True"/>
            <input variable="numidade"/>
            <if expression="numidade&gt;17">
                <then>
                    <output expression="&quot;maior de idade&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;menor de idade&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
