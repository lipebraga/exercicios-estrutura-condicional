    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numqualquer" type="Real" array="False" size=""/>
            <output expression="&quot;insira um numero&quot;" newline="True"/>
            <input variable="numqualquer"/>
            <if expression="numqualquer % 2==0">
                <then>
                    <output expression="&quot; esse numero &#233; par &quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;esse numero &#233; impar &quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
